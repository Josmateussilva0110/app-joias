{
  "expo": {
    "name": "Sintonia",
    "slug": "loja-joias",
    "version": "1.0.26",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lojajoias",
    "userInterfaceStyle": "automatic",
    "android": {
      "usesCleartextTraffic": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1A1410",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mateus0110.lojajoias",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.mateus0110.lojajoias"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1410",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 300
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite entrar no app usando Face ID."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#B8954A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class expo.modules.notifications.** { *; }\n-keep class expo.modules.kotlin.** { *; }\n-keep class expo.modules.device.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf241346-b604-4df1-972f-8c8fae3c9628"
      }
    }
  }
}
