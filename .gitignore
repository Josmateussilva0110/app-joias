app/android/.gradle/
app/android/local.properties
app/android/.cxx/
app/android/.build-config-hash
app/android/app/build/
*.apk
*.aab
*.jks
*.keystore
.kotlin/

# Firebase — chaves privadas de service account (NUNCA commitar)
# google-services.json pode ir pro Git; contém só IDs públicos do app.
*firebase-adminsdk*.json
firebase-service-account*.json

# Certificados e provisioning (iOS/Android)
*.pem
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

