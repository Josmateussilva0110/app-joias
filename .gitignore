# ================================================================
# Monorepo — loja-joias
# Raiz: frontend (app), backend, packages/shared, supabase
# ================================================================

# ── Dependências ────────────────────────────────────────────────
node_modules/

# ── Variáveis de ambiente (segredos) ───────────────────────────
.env
.env.*
!.env.example
!**/.env.example
!env-exemple
!**/env-exemple

# dotenvx / chaves locais
.env.keys
.env.local
.env.*.local

# ── Logs e debug ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Sistema operacional ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

