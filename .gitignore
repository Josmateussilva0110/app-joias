.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ── TypeScript ──────────────────────────────────────────────────
*.tsbuildinfo

# ── Testes / cobertura ──────────────────────────────────────────
coverage/
.nyc_output/

# ── Backend (Express) ───────────────────────────────────────────
backend/dist/

# ── Packages compartilhados ─────────────────────────────────────
packages/*/dist/
packages/*/node_modules/

