.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Gerado em npm start / build (write-api-url.js)
app/src/config/api-url.generated.ts

# Pastas nativas geradas pelo prebuild (quando regeneradas)
app/ios/

# ── Android ─────────────────────────────────────────────────────
